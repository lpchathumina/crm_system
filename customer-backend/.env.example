APP_NAME="Enterprise CRM Customer"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8002
APP_PORT=8002

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database — Customer
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=crm_customer
DB_USERNAME=postgres
DB_PASSWORD=secret

# Redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=customer_

# Cache / Queue / Session
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost:3002,crm.test
CUSTOMER_TOKEN_EXPIRY_DAYS=7

# CORS — Allow only customer frontend
CUSTOMER_FRONTEND_URL=http://localhost:3002

# Mail (Mailgun)
MAIL_MAILER=mailgun
MAIL_FROM_ADDRESS="noreply@crm.example.com"
MAIL_FROM_NAME="Enterprise CRM"
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net

# Sentry
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Mixpanel
MIXPANEL_TOKEN=

# Firebase
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT_ID=

# Swagger
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_UI_DEFAULT_MODELS_EXPAND_DEPTH=2

# Horizon (used in Docker/Linux)
HORIZON_PREFIX=customer_horizon:
